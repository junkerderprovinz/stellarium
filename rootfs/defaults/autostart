#!/bin/sh
# openbox runs this with /bin/sh (dash) whatever the shebang says, and dash
# silently skips bashisms such as [[ ]] and arrays.
#
# Single-app session: Stellarium is launched as the session's main window, and
# the base's openbox maximises it, so the planetarium fills the desktop.
#
# The launch below must not be an `exec`. openbox keeps running when this
# script ends, so the base image's svc-watchdog, enabled by RESTART_APP in the
# Dockerfile, restarts the app by watching for
#
#     pgrep -o -u abc -f "sh $HOME/.config/openbox/autostart"
#
# and `exec` replaces this process, so that pattern stops matching and a closed
# Stellarium stays closed on an empty black desktop. Without `exec` the watchdog
# reports the restart and Stellarium is back within two seconds. LinuxServer's
# own Selkies images do not `exec` here either.

# Pin the XDG dirs to the persistent /config tree for every PUID (under PUID=0
# the session runs as literal root, whose default HOME differs from abc's).
export XDG_CONFIG_HOME="/config/.config"
export XDG_DATA_HOME="/config/.local/share"
export XDG_CACHE_HOME="/config/.cache"

# Stellarium keeps its config, landscapes, downloaded star catalogues and
# screenshots in a dedicated user directory. Pin it explicitly under /config so
# everything the user changes (location, plugins, DSO catalogues) persists
# across image updates regardless of how the base resolves HOME. init-stellarium
# has already created and chowned it.
STEL_USER_DIR="/config/.stellarium"

echo "[stellarium-autostart] launching Stellarium (user-dir=$STEL_USER_DIR)" >&2

# dbus-launch gives Stellarium a session bus (quiets the dbus warnings and lets
# Qt portals work). --exit-with-session ties the bus to the app lifetime.
dbus-launch --exit-with-session /usr/bin/stellarium --user-dir "$STEL_USER_DIR"
